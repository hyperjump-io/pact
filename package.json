{
  "name": "@hyperjump/pact",
  "version": "1.5.1",
  "description": "Higher order functions for iterators and async iterators",
  "keywords": [
    "Hyperjump",
    "Promise",
    "higher order functions",
    "iterator",
    "async iterator",
    "generator",
    "async generator",
    "async"
  ],
  "author": "Jason Desrosiers <jdesrosi@gmail.com>",
  "license": "MIT",
  "repository": "github:hyperjump-io/pact",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hyperjump-io"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./async": {
      "types": "./src/async.d.ts",
      "default": "./src/async.js"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/test-utils.js"
  ],
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "check-website": "node scripts/check-website.js",
    "version": "node scripts/version-docs.js && git add website"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "*",
    "@types/node": "*",
    "@vitest/coverage-v8": "*",
    "oxlint": "*",
    "oxlint-tsgolint": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
