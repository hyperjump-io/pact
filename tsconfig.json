{
  "exclude": ["./docs", "./coverage", "./scratch", "./benchmark"],
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noImplicitReturns": true,
    "checkJs": true,
    "skipLibCheck": false,
    "skipDefaultLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  }
}
